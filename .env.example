# Root environment for openwrt-build-tools.
# Copy to .env and adjust locally as needed.

# OpenWrt build source
OPENWRT_REPO_URL=https://github.com/openwrt/openwrt.git
OPENWRT_BRANCH=openwrt-25.12

# Build/runtime defaults
ENABLE_CUSTOM_FEED=0
MAKE_JOBS=
CONTAINER_PROJECT_DIR=/home/developer/project
CONTAINER_DL_CACHE_DIR=/home/developer/dl_cache
DL_CACHE_DIR=/home/developer/dl_cache
ROUTER_CONFIGS_DIR=router-configs
DEFAULT_ROUTER_CONFIG=router-configs/default.config
CONTAINER_NAME=openwrt_build
IMAGE_NAME=openwrt-openwrt-25.12-builder

# Router access defaults
ROUTER_PASS=r0ut3r

